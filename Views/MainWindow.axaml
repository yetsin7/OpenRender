<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenRender.ViewModels"
        xmlns:ctrl="using:OpenRender.Controls"
        x:Class="OpenRender.Views.MainWindow"
        x:Name="RootWindow"
        Title="Open Render Studio"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        CanResize="True"
        Background="{DynamicResource WindowBgBrush}"
        SystemDecorations="BorderOnly">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto"
          ClipToBounds="True">

        <Border Grid.Row="0"
                Background="#0F1728"
                BorderBrush="{DynamicResource BorderBrushApp}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                PointerPressed="HeaderBar_PointerPressed">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="12"
                            Background="{DynamicResource AccentBrushStrong}">
                        <TextBlock Text="OR"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#07111F"/>
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="OPENRENDER"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   LetterSpacing="1.8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding WorkspaceModeText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Top"
                            Margin="16,0,0,0">
                    <Button Classes="windowControlBtn"
                            Click="MinimizeWindow_Click"
                            ToolTip.Tip="Minimizar">
                        <TextBlock Text="-"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                    </Button>
                    <Button Classes="windowControlBtn"
                            Click="ToggleMaximizeWindow_Click"
                            ToolTip.Tip="Maximizar o restaurar">
                        <TextBlock Text="□"
                                   FontSize="14"/>
                    </Button>
                    <Button Classes="windowControlBtnClose"
                            Click="CloseWindow_Click"
                            ToolTip.Tip="Cerrar">
                        <TextBlock Text="x"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                    </Button>
                </StackPanel>

                <Viewbox Stretch="Uniform"
                         StretchDirection="DownOnly"
                         Margin="18,0,18,0"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Center">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center">
                            <Button Classes="iconToolBtn"
                                    Command="{Binding ImportFileCommand}"
                                    ToolTip.Tip="Importar modelo">
                                <TextBlock Text="+"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                            </Button>
                            <Button Classes="iconToolBtn"
                                    Command="{Binding ReloadCurrentModelCommand}"
                                    IsVisible="{Binding HasLoadedSourceFile}"
                                    ToolTip.Tip="Reimportar archivo actual">
                                <TextBlock Text="↻"
                                           FontSize="18"/>
                            </Button>
                            <Button Classes="iconToolBtn"
                                    Command="{Binding NewSceneCommand}"
                                    ToolTip.Tip="Nuevo estudio vacío">
                                <TextBlock Text="✧"
                                           FontSize="18"/>
                            </Button>
                            <Button Classes="iconToolBtn"
                                    Command="{Binding FrameAllCommand}"
                                    ToolTip.Tip="Encuadrar todo">
                                <TextBlock Text="⛶"
                                           FontSize="18"/>
                            </Button>
                            <Button Classes="iconToolBtn"
                                    Command="{Binding ResetCameraCommand}"
                                    ToolTip.Tip="Resetear cámara">
                                <TextBlock Text="◎"
                                           FontSize="18"/>
                            </Button>

                            <Border Classes="toolbarDivider"/>

                            <ToggleButton Classes="modeBtn"
                                          IsChecked="{Binding IsObjectSelectionMode, Mode=OneWay}"
                                          Command="{Binding SetInteractionModeCommand}"
                                          CommandParameter="Object"
                                          ToolTip.Tip="Modo objeto: un clic selecciona el modelo completo">
                                <TextBlock Text="◫"
                                           FontSize="16"/>
                            </ToggleButton>
                            <ToggleButton Classes="modeBtn"
                                          IsChecked="{Binding IsMaterialPaintMode, Mode=OneWay}"
                                          Command="{Binding SetInteractionModeCommand}"
                                          CommandParameter="Material"
                                          ToolTip.Tip="Modo material: un clic selecciona una superficie">
                                <TextBlock Text="◪"
                                           FontSize="16"/>
                            </ToggleButton>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center">
                            <Button Classes="miniToolBtn"
                                    Command="{Binding SetViewCommand}"
                                    CommandParameter="3D"
                                    ToolTip.Tip="Vista 3D">
                                <TextBlock Text="⬢"/>
                            </Button>
                            <Button Classes="miniToolBtn"
                                    Command="{Binding SetViewCommand}"
                                    CommandParameter="Front"
                                    ToolTip.Tip="Vista frente">
                                <TextBlock Text="▤"/>
                            </Button>
                            <Button Classes="miniToolBtn"
                                    Command="{Binding SetViewCommand}"
                                    CommandParameter="Left"
                                    ToolTip.Tip="Vista izquierda">
                                <TextBlock Text="↤"/>
                            </Button>
                            <Button Classes="miniToolBtn"
                                    Command="{Binding SetViewCommand}"
                                    CommandParameter="Right"
                                    ToolTip.Tip="Vista derecha">
                                <TextBlock Text="↦"/>
                            </Button>
                            <Button Classes="miniToolBtn"
                                    Command="{Binding SetViewCommand}"
                                    CommandParameter="Top"
                                    ToolTip.Tip="Vista superior">
                                <TextBlock Text="⇡"/>
                            </Button>

                            <Border Classes="toolbarDivider"/>

                            <Button Classes="miniToolBtn"
                                    Command="{Binding PreparePhotoShotCommand}"
                                    ToolTip.Tip="Preparar primera foto">
                                <TextBlock Text="◉"/>
                            </Button>
                            <Button Classes="miniToolBtn"
                                    Command="{Binding RenderCommand}"
                                    ToolTip.Tip="Actualizar preview">
                                <TextBlock Text="⌁"/>
                            </Button>
                            <Button Classes="miniToolBtn"
                                    Command="{Binding ExportRenderCommand}"
                                    ToolTip.Tip="Exportar imagen">
                                <TextBlock Text="⤓"/>
                            </Button>
                            <Button Classes="miniToolBtn"
                                    Command="{Binding OpenGithubCommand}"
                                    ToolTip.Tip="Abrir repositorio de GitHub">
                                <Path Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource TextPrimaryBrush}"
                                      Data="M7,0.6C3.15,0.6 0,3.78 0,7.7C0,10.84 2.01,13.5 4.79,14.44C5.14,14.5 5.26,14.28 5.26,14.09C5.26,13.92 5.25,13.36 5.24,12.62C3.29,13.06 2.88,11.76 2.88,11.76C2.56,10.93 2.1,10.71 2.1,10.71C1.46,10.26 2.15,10.27 2.15,10.27C2.86,10.32 3.24,11.02 3.24,11.02C3.87,12.13 4.89,11.81 5.3,11.62C5.36,11.15 5.55,10.83 5.76,10.65C4.2,10.47 2.56,9.84 2.56,7.03C2.56,6.23 2.84,5.57 3.31,5.04C3.24,4.86 2.99,4.11 3.38,3.09C3.38,3.09 3.97,2.9 5.24,3.79C5.8,3.63 6.4,3.55 7,3.55C7.6,3.55 8.2,3.63 8.76,3.79C10.03,2.9 10.62,3.09 10.62,3.09C11.01,4.11 10.76,4.86 10.69,5.04C11.16,5.57 11.44,6.23 11.44,7.03C11.44,9.85 9.79,10.47 8.23,10.65C8.49,10.88 8.72,11.34 8.72,12.05C8.72,13.07 8.71,13.89 8.71,14.09C8.71,14.28 8.83,14.5 9.18,14.44C11.99,13.49 14,10.83 14,7.7C14,3.78 10.85,0.6 7,0.6Z"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Viewbox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1"
              Background="{DynamicResource WindowBgBrush}">

            <ctrl:ViewportControl x:Name="ViewportHost"
                                  Scene="{Binding Scene}"/>

            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Width="296"
                    Margin="16,16,0,16"
                    Classes="overlayPanel">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="panelCard" Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding CurrentSceneLabel}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding LoadedModelInfo}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       MaxLines="3"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <WrapPanel>
                                <Border Classes="metricChip" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding ObjectCount}" Classes="metricChipText"/>
                                </Border>
                                <Border Classes="metricChip" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding TriangleCount, StringFormat={}{0:N0}}" Classes="metricChipText"/>
                                </Border>
                                <Border Classes="metricChip">
                                    <TextBlock Text="{Binding MaterialCount}" Classes="metricChipText"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TabControl Grid.Row="1"
                                Margin="0,12,0,0"
                                MinHeight="0"
                                Classes="panelTabs">
                        <TabItem Header="Escena">
                            <Border Classes="panelCard" Padding="12">
                                <Grid RowDefinitions="Auto,*">
                                    <TextBox Grid.Row="0"
                                             Watermark="Filtrar..."
                                             Text="{Binding SceneFilterText}"
                                             Background="#0E1626"
                                             BorderBrush="{DynamicResource BorderBrushApp}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ListBox Grid.Row="1"
                                             Margin="0,10,0,0"
                                             MinHeight="0"
                                             ItemsSource="{Binding SceneNodes}"
                                             SelectedItem="{Binding SelectedSceneNode}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="sceneItemCard">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Border Width="34" Height="34" CornerRadius="10" Background="#18324F">
                                                            <TextBlock Text="{Binding Icon}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="0,0,10,0"
                                                                    Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Subtitle}"
                                                                       FontSize="10"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="2"
                                                                  IsVisible="{Binding SupportsVisibility}"
                                                                  IsChecked="{Binding IsVisible}"
                                                                  VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </TabItem>

                        <TabItem Header="Biblioteca">
                            <Border Classes="panelCard" Padding="12">
                                <Grid RowDefinitions="Auto,*">
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding ImportedLibraryInfoText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ScrollViewer Grid.Row="1"
                                                  Margin="0,10,0,0"
                                                  MinHeight="0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="8">
                                            <ItemsControl ItemsSource="{Binding ImportedHistory}"
                                                          IsVisible="{Binding HasImportedHistory}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Padding="12,10"
                                                                HorizontalContentAlignment="Left"
                                                                Classes="recentBtn"
                                                                Command="{Binding #RootWindow.DataContext.OpenRecentFileCommand}"
                                                                CommandParameter="{Binding FilePath}">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Summary}"
                                                                           FontSize="10"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock Text="{Binding Meta}"
                                                                           FontSize="10"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Aún no hay modelos guardados."
                                                       IsVisible="{Binding !HasImportedHistory}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="312"
                    Margin="0,16,16,16"
                    Classes="overlayPanel">
                <TabControl Classes="panelTabs"
                            MinHeight="0">
                    <TabItem Header="Material">
                        <Border Classes="panelCard" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          MinHeight="0"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding SelectedNodeTitle}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding SelectedNodeDetails}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>

                                    <Border Background="#111B2D"
                                            BorderBrush="{DynamicResource BorderBrushApp}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10"
                                            IsVisible="{Binding !IsMaterialPaintMode}">
                                        <TextBlock Text="Activa MAT arriba para seleccionar superficies con un clic."
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>

                                    <StackPanel Spacing="10"
                                                IsVisible="{Binding HasSelectedMaterial}">
                                        <DockPanel>
                                            <TextBlock Text="Material" Width="90" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedMaterial.Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="Origen" Width="90" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedMaterialSourceText}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="Uso" Width="90" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedMaterialUsageText}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="R" Width="24" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MaterialAlbedoR, StringFormat={}{0:F2}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Slider Minimum="0" Maximum="1" Value="{Binding MaterialAlbedoR}" Margin="8,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="G" Width="24" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MaterialAlbedoG, StringFormat={}{0:F2}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Slider Minimum="0" Maximum="1" Value="{Binding MaterialAlbedoG}" Margin="8,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="B" Width="24" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MaterialAlbedoB, StringFormat={}{0:F2}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Slider Minimum="0" Maximum="1" Value="{Binding MaterialAlbedoB}" Margin="8,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="Rough" Width="48" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedMaterial.Roughness, StringFormat={}{0:F2}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Slider Minimum="0" Maximum="1" Value="{Binding SelectedMaterial.Roughness}" Margin="8,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="Metal" Width="48" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedMaterial.Metallic, StringFormat={}{0:F2}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Slider Minimum="0" Maximum="1" Value="{Binding SelectedMaterial.Metallic}" Margin="8,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="Opac" Width="48" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedMaterial.Opacity, StringFormat={}{0:F2}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Slider Minimum="0" Maximum="1" Value="{Binding SelectedMaterial.Opacity}" Margin="8,0,8,0"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <TextBlock Text="Selecciona una superficie para editar su material."
                                               IsVisible="{Binding !HasSelectedMaterial}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>

                                    <Border Height="1" Background="{DynamicResource BorderBrushApp}"/>

                                    <ComboBox ItemsSource="{Binding MaterialLibraryPresets}"
                                              SelectedItem="{Binding SelectedLibraryMaterial}"
                                              MaxDropDownHeight="320">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"/>
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="{Binding SelectedLibraryMaterial.Description}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    <Grid ColumnDefinitions="*,*">
                                        <Button Grid.Column="0"
                                                Margin="0,0,8,0"
                                                Content="Aplicar"
                                                Classes="accentActionBtn"
                                                Command="{Binding ApplySelectedLibraryPresetCommand}"
                                                IsVisible="{Binding HasSelectedMeshNode}"/>
                                        <Button Grid.Column="1"
                                                Content="Auto"
                                                Classes="ghostActionBtn"
                                                Command="{Binding AutoStyleSceneMaterialsCommand}"/>
                                    </Grid>

                                    <WrapPanel>
                                        <Button Content="Cantera" Classes="chipBtn" Command="{Binding ApplyMaterialPresetCommand}" CommandParameter="stone-cantera"/>
                                        <Button Content="Concreto" Classes="chipBtn" Command="{Binding ApplyMaterialPresetCommand}" CommandParameter="concrete-polished"/>
                                        <Button Content="Cerámica" Classes="chipBtn" Command="{Binding ApplyMaterialPresetCommand}" CommandParameter="ceramic-ivory"/>
                                        <Button Content="Nogal" Classes="chipBtn" Command="{Binding ApplyMaterialPresetCommand}" CommandParameter="wood-walnut"/>
                                        <Button Content="Vidrio" Classes="chipBtn" Command="{Binding ApplyMaterialPresetCommand}" CommandParameter="glass-clear"/>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <TabItem Header="Cámara">
                        <Border Classes="panelCard" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          MinHeight="0">
                                <StackPanel Spacing="12">
                                    <DockPanel>
                                        <TextBlock Text="FOV" Width="80" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CameraFov, StringFormat={}{0:F0}°}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Slider Minimum="20" Maximum="110" Value="{Binding CameraFov}" Margin="8,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Distancia" Width="80" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CameraDistance, StringFormat={}{0:F1}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Slider Minimum="0.5" Maximum="2500" Value="{Binding CameraDistance}" Margin="8,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Velocidad" Width="80" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding NavigationSpeed, StringFormat={}{0:F1}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Slider Minimum="0.5" Maximum="250" Value="{Binding NavigationSpeed}" Margin="8,0,8,0"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding CameraFocusText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <TabItem Header="Foto">
                        <Border Classes="panelCard" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          MinHeight="0">
                                <StackPanel Spacing="12">
                                    <WrapPanel>
                                        <Button Content="HD" Classes="chipBtn" Command="{Binding SetResolutionPresetCommand}" CommandParameter="HD"/>
                                        <Button Content="FHD" Classes="chipBtn" Command="{Binding SetResolutionPresetCommand}" CommandParameter="FHD"/>
                                        <Button Content="QHD" Classes="chipBtn" Command="{Binding SetResolutionPresetCommand}" CommandParameter="QHD"/>
                                        <Button Content="4K" Classes="chipBtn" Command="{Binding SetResolutionPresetCommand}" CommandParameter="4K"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <Button Content="PNG" Classes="chipBtn" Command="{Binding SetOutputFormatCommand}" CommandParameter="Png"/>
                                        <Button Content="JPEG" Classes="chipBtn" Command="{Binding SetOutputFormatCommand}" CommandParameter="Jpeg"/>
                                        <Button Content="TIFF" Classes="chipBtn" Command="{Binding SetOutputFormatCommand}" CommandParameter="Tiff"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <Button Content="Draft" Classes="chipBtn" Command="{Binding SetQualityCommand}" CommandParameter="Draft"/>
                                        <Button Content="High" Classes="chipBtn" Command="{Binding SetQualityCommand}" CommandParameter="High"/>
                                        <Button Content="Ultra" Classes="chipBtn" Command="{Binding SetQualityCommand}" CommandParameter="Ultra"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <Button Content="Day" Classes="chipBtn" Command="{Binding ApplyEnvironmentPresetCommand}" CommandParameter="Day"/>
                                        <Button Content="Overcast" Classes="chipBtn" Command="{Binding ApplyEnvironmentPresetCommand}" CommandParameter="Overcast"/>
                                        <Button Content="Sunset" Classes="chipBtn" Command="{Binding ApplyEnvironmentPresetCommand}" CommandParameter="Sunset"/>
                                        <Button Content="Studio" Classes="chipBtn" Command="{Binding ApplyEnvironmentPresetCommand}" CommandParameter="Studio"/>
                                    </WrapPanel>
                                    <DockPanel>
                                        <TextBlock Text="Sol" Width="80" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SunIntensity, StringFormat={}{0:F1}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Slider Minimum="0" Maximum="5" Value="{Binding SunIntensity}" Margin="8,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Ambiente" Width="80" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AmbientIntensity, StringFormat={}{0:F2}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding AmbientIntensity}" Margin="8,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Exposición" Width="80" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PhotoExposure, StringFormat={}{0:F2}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Slider Minimum="0.40" Maximum="2.20" Value="{Binding PhotoExposure}" Margin="8,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Gamma" Width="80" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PhotoGamma, StringFormat={}{0:F2}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Slider Minimum="1.40" Maximum="2.80" Value="{Binding PhotoGamma}" Margin="8,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Contraste" Width="80" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PhotoContrast, StringFormat={}{0:F2}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Slider Minimum="0.70" Maximum="1.40" Value="{Binding PhotoContrast}" Margin="8,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Temp." Width="80" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PhotoWhiteBalance, StringFormat={}{0:F2}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Slider Minimum="-0.40" Maximum="0.40" Value="{Binding PhotoWhiteBalance}" Margin="8,0,8,0"/>
                                    </DockPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                </TabControl>
            </Border>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="18,14"
                    CornerRadius="18"
                    Background="#C20B1322"
                    BorderBrush="{DynamicResource BorderBrushApp}"
                    BorderThickness="1"
                    IsVisible="{Binding ShowEmptyState}">
                <StackPanel Spacing="8"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Viewport listo"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Importa un modelo OBJ para empezar."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <Button Content="Importar"
                            Classes="accentActionBtn"
                            Command="{Binding ImportFileCommand}"/>
                </StackPanel>
            </Border>

            <Border Background="#C410192D"
                    IsVisible="{Binding IsLoading}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="320"
                            Spacing="12">
                    <TextBlock Text="Preparando geometría..."
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Height="10"
                                 Value="{Binding ProgressValue}"/>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#0D1524"
                BorderBrush="{DynamicResource BorderBrushApp}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="{Binding CameraFocusText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Grid.Column="2"
                           Margin="14,0,0,0"
                           Text="{Binding RenderInfoText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </Grid>
        </Border>
    </Grid>

    <Window.Styles>
        <Style Selector="Border.overlayPanel">
            <Setter Property="Background" Value="#D20C1424"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style Selector="Border.panelCard">
            <Setter Property="Background" Value="#D1121D31"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style Selector="Border.sceneItemCard">
            <Setter Property="Background" Value="#10192A"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style Selector="Button.iconToolBtn">
            <Setter Property="Background" Value="#18253B"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="Button.miniToolBtn">
            <Setter Property="Background" Value="#162132"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="ToggleButton.modeBtn">
            <Setter Property="Background" Value="#162132"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style Selector="ToggleButton.modeBtn:checked">
            <Setter Property="Background" Value="{DynamicResource AccentBrushStrong}"/>
            <Setter Property="Foreground" Value="#07111F"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrushStrong}"/>
        </Style>

        <Style Selector="Button.windowControlBtn">
            <Setter Property="Background" Value="#152034"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="Button.windowControlBtnClose">
            <Setter Property="Background" Value="#3A1A22"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#6A3340"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="Border.topBadge">
            <Setter Property="Background" Value="#162132"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style Selector="TextBlock.topBadgeText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Border.metricChip">
            <Setter Property="Background" Value="#0E1626"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style Selector="TextBlock.metricChipText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Border.toolbarDivider">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrushApp}"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style Selector="Button.ghostActionBtn">
            <Setter Property="Background" Value="#162132"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.accentActionBtn">
            <Setter Property="Background" Value="{DynamicResource AccentBrushStrong}"/>
            <Setter Property="Foreground" Value="#07111F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="Button.chipBtn">
            <Setter Property="Background" Value="#121B2B"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style Selector="Button.recentBtn">
            <Setter Property="Background" Value="#10192A"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushApp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style Selector="TabControl.panelTabs">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

</Window>
