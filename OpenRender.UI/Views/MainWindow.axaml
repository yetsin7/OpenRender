<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenRender.ViewModels"
        xmlns:sections="using:OpenRender.Views.Sections"
        x:Class="OpenRender.Views.MainWindow"
        x:Name="RootWindow"
        Title="OpenRender"
        Width="1600"
        Height="1280"
        MinWidth="1280"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        CanResize="True"
        Background="#131313"
        SystemDecorations="BorderOnly">

    <Window.Styles>
        <StyleInclude Source="avares://OpenRender.UI/Styles/WorkspaceStyles.axaml" />
    </Window.Styles>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="56,*">
        <Border Grid.Row="0"
                Background="#131313"
                BorderBrush="#3E4850"
                BorderThickness="0,0,0,1"
                Padding="20,0"
                PointerPressed="HeaderBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch"
                            Spacing="24">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Button Classes="chromeIconButton"
                                Command="{Binding ToggleLumionLeftRailCommand}"
                                IsVisible="{Binding ShowMenuChrome}"
                                Content="&#xE700;"
                                VerticalAlignment="Center" />

                        <TextBlock VerticalAlignment="Center"
                                   Classes="brandText"
                                   Text="{Binding Text.Brand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="24"
                                VerticalAlignment="Stretch">
                        <Button Classes="topNavButton"
                                Classes.active="{Binding IsDashboardSectionActive}"
                                Command="{Binding SetWorkspaceSectionCommand}"
                                CommandParameter="Dashboard"
                                Content="{Binding Text.NavDashboard}" />
                        <Button Classes="topNavButton"
                                Classes.active="{Binding IsLibrarySectionActive}"
                                Command="{Binding SetWorkspaceSectionCommand}"
                                CommandParameter="Library"
                                Content="{Binding Text.NavLibrary}" />
                        <Button Classes="topNavButton"
                                Classes.active="{Binding IsRenderSectionActive}"
                                Command="{Binding SetWorkspaceSectionCommand}"
                                CommandParameter="Render"
                                Content="{Binding Text.NavRender}" />
                        <Button Classes="topNavButton"
                                Classes.active="{Binding IsCameraSectionActive}"
                                Command="{Binding SetWorkspaceSectionCommand}"
                                CommandParameter="Camera"
                                Content="{Binding Text.NavCamera}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Border Width="320"
                            Height="38"
                            Margin="0,0,12,0"
                            Classes="searchHost"
                            IsVisible="{Binding ShowProjectSearchChrome}">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Margin="12,0,8,0"
                                       VerticalAlignment="Center"
                                       Classes="monoValue"
                                       FontFamily="Segoe Fluent Icons"
                                       Text="&#xE721;" />
                            <TextBox Grid.Column="1"
                                     Classes="searchBox chromeSearchBox"
                                     Watermark="{Binding Text.SearchProjects}"
                                     Text="{Binding ProjectSearchText}" />
                        </Grid>
                    </Border>

                    <Button Classes="chromeIconButton"
                            Command="{Binding ExportRenderCommand}"
                            Content="&#xE74E;" />
                    <Button Classes="chromeIconButton"
                            Command="{Binding AboutCommand}"
                            Content="&#xE713;" />
                    <Button Classes="chromeIconButton"
                            Command="{Binding ShortcutsCommand}"
                            Content="&#xE897;" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <sections:DashboardView IsVisible="{Binding IsDashboardSectionActive}" />
            <sections:LibraryView IsVisible="{Binding IsLibrarySectionActive}" />
            <sections:RenderQueueView IsVisible="{Binding IsRenderSectionActive}" />
            <sections:CameraWorkspaceView IsVisible="{Binding IsCameraSectionActive}" />
        </Grid>
    </Grid>
</Window>
